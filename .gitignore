# Python / packaging
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
*.swp

# LaTeX build artifacts (keep .tex and .pdf)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb

# Generated outputs — large; stay out of source control
/results
/data
/local_snapshots
# Checkpoints / tensor payloads, wherever they land (the quickstart loads a
# bare checkpoint.pt from the repo root; results/ + data/ are already covered).
*.pt
*.pth
*.ckpt
*.safetensors

# Secrets / local env — never ship (gated Gemma/Llama downloads need an HF token)
.env
.env.*
*.pem
*.key

# Optional local convenience: developers can `ln -s` an external paper-LaTeX
# workspace as `paper/` (e.g. for figure pickup); the symlink is local-only
# and must not propagate. `Sparse_Readout_Prism` is the same convenience
# under the paper's own name.
/paper
/Sparse_Readout_Prism

# Local cluster wrappers — these are per-deployment sbatch / slurm scripts
# with hardcoded NFS paths, partition names, and credentials.
/scripts/cluster/

# Internal write-ups / reports — paper-internal markdown that should not
# propagate to the public repo.
/docs/reports/

# Standalone probe experiments live outside the canonical reproduction path;
# they get their own checkout (see CONTRIBUTING.md) and are not shipped.
/experiments/

# Vendored template archives + zips
*.zip

# Local dev scratch files
PROMPT.md
symbolic_math_*.md

# Agent / assistant config
.claude/

# Local Netlify folder
.netlify
